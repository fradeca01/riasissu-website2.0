---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/MyHome.astro'
import ChiSiamo from '../components/blocks/features/ChiSiamo.astro'
import CTA from '../components/blocks/CTA/Dona.astro'
// Content
import HomepageBlog from '../components/blocks/blog/HomepageBlog.astro'
// - SEO
const SEO = {
	title: "RIASISSU | Scuole d'eccellenza in Italia",
	description:
		'La “Rete Italiana dellɜ Allievɜ delle Scuole e degli Istituti di Studi Superiori Universitari” è un’associazione costituita nell’aprile 2016 e iscritta al RUNTS da maggio 2023. Ad essa prendono parte gli allievi di tutte le Scuole Superiori Universitarie italiane che condividono i principi dello Statuto dell’associazione. Ha principalmente due scopi: uno interno, ovvero creare connessioni fra gli allievi soci; uno esterno, cioè promuovere la cultura del merito nella collettività. '
}


---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<HomepageBlog classes="bg-slate-50 dark:bg-neutral-900/40" />
	<ChiSiamo />
	<CTA />
</Layout>
