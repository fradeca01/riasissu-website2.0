---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
// - Content
// Il testo dello statuto vive in un file Markdown separato per non intasare la pagina.
// `compiledContent()` restituisce l'HTML già renderizzato; lo spezziamo sul marcatore
// `<!--SECTION-->` per iniettare ogni gruppo di articoli accanto alla sua etichetta di
// sidebar. L'ordine di `sidebarLabels` deve corrispondere all'ordine delle sezioni nel .md.
import { compiledContent } from '../data/markdown-files/statuto.md'

// Content
// - SEO
const SEO = {
	title: 'RIASISSU | Statuto',
	description: "Statuto dell'associazione RIASISSU, approvato il 6 dicembre 2024."
}
// - Page Header
const header = {
	title: '<strong>Statuto</strong> dell’associazione <strong>RIASISSU</strong>',
	text: ''
}
// - Etichette delle sidebar sticky, una per sezione (nell'ordine del Markdown)
const sidebarLabels = ['Disposizioni Generali', 'Associati', 'Patrimonio', 'Organi Sociali']
const sections = (await compiledContent()).split('<!--SECTION-->')
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	{
		sections.map((section, i) => (
			<SidebarContent>
				<div slot="sidebar">
					<h3>{sidebarLabels[i]}</h3>
				</div>
				<div class="basic-text legal-body" set:html={section} />
			</SidebarContent>
		))
	}
</Layout>
