---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
import Row from '../components/ui/Row.astro'

// Content
// - SEO
const SEO = {
	title: 'RIASISSU | Contatta la RIASISSU',
	description:
		'Per qualunque domanda o informazione puoi contattarci alle seguente mail.'
}
// - Page Header
const header = {
	title: 'Contatta la RIASISSU',
	text: "Per qualunque domanda o informazione puoi contattarci alle seguenti mail."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Row>
	</Row>
			<ContactCards classes="dark:bg-neutral-950/80" />

</Layout>
