---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import Rappresentanti from '../components/blocks/features/Rappresentanti.astro'
import Giunta from '../components/blocks/features/Giunta.astro'

// Content
// - SEO
const SEO = {
	title: "RIASISSU | Scuole d'eccellenza in Italia",
	description: "Organigramma dell'associazione RIASISSU"
}
// - Page Header
const header = {
	title: "Organigramma dell'associazione",
	text: 'RIASISSU, Rete Italiana dellɜ Allievɜ delle Scuole e degli Istituti di Studi Superiori Universitari - APS.'
}

---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Giunta />
	<Rappresentanti />

</Layout>
