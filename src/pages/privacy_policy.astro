---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
// - Content
// L'informativa vive in un Markdown separato: `compiledContent()` la rende in HTML e la
// spezziamo sul marcatore `<!--SECTION-->`, iniettando ogni gruppo di paragrafi accanto alla
// sua etichetta di sidebar. `sidebarLabels` segue l'ordine delle sezioni nel .md.
// La classe `legal-body--spaced` aggiunge la spaziatura tra paragrafi propria di questa pagina.
import { compiledContent } from '../data/markdown-files/privacy.md'

// Content
// - SEO
const SEO = {
	title: 'RIASISSU | Privacy Policy',
	description: 'Informativa sul trattamento dei dati personali per il sito riasissu.it.'
}
// - Page Header
const header = {
	title: 'Informativa privacy',
	text: ''
}
const sidebarLabels = [
	'Informazioni generali',
	'Dati trattati e finalità',
	'Servizi di terze parti',
	'Diritti degli interessati'
]
const sections = (await compiledContent()).split('<!--SECTION-->')
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	{
		sections.map((section, i) => (
			<SidebarContent>
				<div slot="sidebar">
					<h3>{sidebarLabels[i]}</h3>
				</div>
				<div class="basic-text legal-body legal-body--spaced" set:html={section} />
			</SidebarContent>
		))
	}
</Layout>
