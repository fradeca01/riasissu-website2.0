---
import Layout from '../layouts/Layout.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
// Il testo del regolamento vive in un Markdown separato: `compiledContent()` lo rende in
// HTML e lo spezziamo sul marcatore `<!--SECTION-->`, iniettando ogni articolo accanto alla
// sua etichetta di sidebar. L'ordine di `sidebarLabels` segue l'ordine delle sezioni nel .md.
import { compiledContent } from '../data/markdown-files/regolamento.md'

const SEO = {
	title: 'RIASISSU | Regolamento dell’associazione',
	description: "Regolamento dell'associazione RIASISSU, approvato il 6 dicembre 2024."
}
const header = {
	title: '<strong>Regolamento</strong> dell’associazione <strong>RIASISSU</strong>',
	text: ''
}
const sidebarLabels = [
	'Art. 1 - Ingresso nuove scuole',
	'Art. 2 - Procedura di votazione alle assemblee',
	'Art. 3 - Cariche sociali',
	'Art. 4 - Commissioni',
	'Disposizioni finali'
]
const sections = (await compiledContent()).split('<!--SECTION-->')
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	{
		sections.map((section, i) => (
			<SidebarContent>
				<div slot="sidebar">
					<h3>{sidebarLabels[i]}</h3>
				</div>
				<div class="basic-text legal-body" set:html={section} />
			</SidebarContent>
		))
	}
</Layout>
