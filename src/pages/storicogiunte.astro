---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import SimpleFeed from '../components/blocks/feeds/BasicFeed.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'

// Data
import feedData from '../data/json-files/changelogData.json'
import giunteData from '../data/json-files/storicoData.json'
import { Image } from 'astro:assets'

// Content
// - SEO
const SEO = {
	title: "RIASISSU | Scuole d'eccellenza in Italia",
	description:
		"Esplora la storia delle giunte della RIASISSU, con dettagli sui coordinatori, vice, tesorieri e segretari che hanno guidato l'associazione nel corso degli anni."
}
// - Page Header
const header = {
	title: 'Storia delle <strong>Giunte</strong> della RIASISSU',
	text: ''
}

const processData = giunteData.map((item) => {
	return {
		title: '',
		date: `${item.year}`,
		text: `<ul>${
			item.roles.coordinatoreM
				? `<li><strong>Coordinatore:</strong> ${item.roles.coordinatoreM.firstName} ${item.roles.coordinatoreM.lastName}</li>`
				: ''
		}
		${
			item.roles.coordinatoreF
				? `<li><strong>Coordinatrice:</strong> ${item.roles.coordinatoreF.firstName} ${item.roles.coordinatoreF.lastName}</li>`
				: ''
		}
		${
			item.roles.viceM
				? `<li><strong>Coordinatore Vicario:</strong> ${item.roles.viceM.firstName} ${item.roles.viceM.lastName}</li>`
				: ''
		}
		${
			item.roles.viceF
				? `<li><strong>Coordinatrice Vicaria:</strong> ${item.roles.viceF.firstName} ${item.roles.viceF.lastName}</li>`
				: ''
		}
		${
			item.roles.tesoriereM
				? `<li><strong>Tesoriere:</strong> ${item.roles.tesoriereM.firstName} ${item.roles.tesoriereM.lastName}</li>`
				: ''
		}
		${
			item.roles.tesoriereF
				? `<li><strong>Tesoriere:</strong> ${item.roles.tesoriereF.firstName} ${item.roles.tesoriereF.lastName}</li>`
				: ''
		}
		${
			item.roles.segretarioM
				? `<li><strong>Segretario:</strong> ${item.roles.segretarioM.firstName} ${item.roles.segretarioM.lastName}</li>`
				: ''
		}
				
		${item.roles.segretarioF
				? `<li><strong>Segretaria:</strong> ${item.roles.segretarioF.firstName} ${item.roles.segretarioF.lastName}</li>`
				: ''
		}
		
		
		</ul>`,
		image: ''
	}
})
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<SimpleFeed data={processData} />
	<!-- <CTA /> -->
</Layout>
