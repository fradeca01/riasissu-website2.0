---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import SchoolGrid from './SchoolGrid.astro'
import Button from '../../ui/Button.astro'
import SchoolModal from '../modal/SchoolModal.astro'

// Content
import { schoolsData } from '../../../data/json-files/schoolsData.js'
---

<Section id="features" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Le Scuole</h2>
			<p class="pb-0 text-lg">
				Scopri le scuole che fanno parte della rete RIASISSU. Ogni scuola rappresenta
				un'eccellenza accademica e culturale in Italia.
			</p>
		</Col>
	</Row>
	{/* Stato Alpine `open`: su desktop (>=1024px) le colonne 2-3 sono sempre aperte; su
	    mobile partono chiuse e il pulsante "Mostra Altro" le mostra/nasconde (toggle).
	    Il listener di resize riallinea `open` quando si supera il breakpoint. */}
	<div
		x-data="{open : window.innerWidth >= 1024,
				toggle() {
				if (this.open) {
					return this.close()
					}
					this.open = true

						},
						close(focusAfter) {
							if (! this.open) return

							this.open = false

							focusAfter && focusAfter.focus()
						},
				init() {
					window.addEventListener('resize', () => {
						this.open = window.innerWidth >= 1024
					})
				}
            }"
		x-init="init()"
	>
		{/* Le 12 scuole sono divise in 3 colonne da 4. La prima colonna è sempre visibile
		    su desktop (firstColumn); le altre due compaiono al toggle "Mostra Altro". */}
		<Row classes="lg:mx-12">
			<SchoolGrid schools={schoolsData.slice(0, 4)} firstColumn={true} />
			<SchoolGrid schools={schoolsData.slice(4, 8)} />
			<SchoolGrid schools={schoolsData.slice(8, 12)} />
		</Row>

		<Row classes="">
			<Col span="12" classes="text-center">
				<div class="mt-6 flex justify-center lg:hidden">
					<Button onClick="toggle()" style="primary" size="lg">
						<span x-text="open ? 'Mostra Meno' : 'Mostra Altro'"></span>
					</Button>
				</div>
			</Col>
		</Row>
	</div>
</Section>
{
	schoolsData.map((school) => (
		<SchoolModal
			id={school.id}
			title={school.scuola}
			description={school.description}
			image={school.image}
			link={school.link}
		/>
	))
}
